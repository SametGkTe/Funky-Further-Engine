<?xml version="1.0" encoding="utf-8"?>
<project>
	<!-- _________________________ Application Settings _________________________ -->

	<app title="Further Engine" file="FurtherEngine" packageName="com.sametgkte.furtherengine" package="com.sametgkte.furtherengine" main="Main" version="0.2.8" company="SametGkTe" />

	<!--Switch Export with Unique ApplicationID and Icon-->
	<set name="APP_ID" value="0x0100f6c013bbc000" />

	<!-- NOTE TO SELF: DISABLE THIS IF ISSUES ARE FOUND -->
	<haxedef name="LINC_LUA_RELATIVE_DYNAMIC_LIB"/> <!-- stable luas PUT AFTER FIRST LINE WITH APP NAME AND ETC -->

	<!--The flixel preloader is not accurate in Chrome. You can use it regularly if you embed the swf into a html file
		or you can set the actual size of your file manually at "FlxPreloaderBase-onUpdate-bytesTotal"-->
	<!-- <app preloader="Preloader" resizable="true" /> -->
	<app preloader="flixel.system.FlxPreloader" />

	<!--Minimum without FLX_NO_GAMEPAD: 11.8, without FLX_NO_NATIVE_CURSOR: 11.2-->
	<set name="SWF_VERSION" value="11.8" />
	
	<!-- ______________________ PSYCH ENGINE CUSTOMIZATION ______________________ -->

	<define name="MODS_ALLOWED" if="desktop || mobile" />
	<define name="HSCRIPT_ALLOWED" if="desktop || mobile" />
	<define name="LUA_ALLOWED" if="cpp" />
	<!-- CNE HScript desteği (hscript-improved vendored: source/cne/compatibility, ek haxelib gerekmez) -->
	<define name="HSC_ALLOWED" if="desktop || mobile" />
	<define name="CUSTOM_CLASSES" if="HSC_ALLOWED" />
	<define name="POLYMOD_ALLOWED" if="desktop || mobile" /> <!-- V-Slice .hxc script koprusu -->
	<haxedef name="hscriptPos" if="POLYMOD_ALLOWED" />
	<set name="POLYMOD_SCRIPT_EXT" value=".hscript" />
	<!-- POLYMOD RUNTIME SINIF COZUMU: Polymod script siniflarini string adla
	     Type.resolveClass ile bulur. DCE (dead code elimination) engine'in
	     statik kullanmadigi siniflari ikiliden silerse "Could not import"
	     hatalari alinir. FNF de ayni sebepten DCE'yi kapatir ve funkin.*
	     paketini zorla derlemeye dahil eder (project.hxp satir 1062-1066).
	     NOT: include('vslice', true) KULLANMAYIN - vslice/menus ve
	     vslice/stages altinda hic derlenmemis olu dosyalar var (CrashState,
	     AttractState, Template.hx). Sadece runtime'da string ile cozulen
	     vslice.scripting paketi zorlanir; menus/stages zaten statik
	     referanslidir. -->
	<haxeflag name="-dce" value="no" if="POLYMOD_ALLOWED" />
	<haxeflag name="--macro" value="include('funkin', true)" if="POLYMOD_ALLOWED" />
	<haxeflag name="--macro" value="include('vslice.scripting', true)" if="POLYMOD_ALLOWED" />
	<haxedef name="HSCRIPT_ABSTRACT_SUPPORT" if="HSC_ALLOWED" />
	<haxedef name="hscriptPos" if="HSC_ALLOWED" />
	<haxeflag name="--macro" value="keep('IntIterator')" if="HSC_ALLOWED" />
	<haxeflag name="--macro" value="cne.compatibility.codenamecrew.hscript.macros.AbstractHandler.init()" if="HSC_ALLOWED" />
	<haxeflag name="--macro" value="cne.compatibility.codenamecrew.hscript.macros.ClassExtendMacro.init()" if="HSC_ALLOWED" />
	<define name="ACHIEVEMENTS_ALLOWED" />
	<!-- Further Online 1v1 (Colyseus). Remove define to disable multiplayer compile. -->
	<define name="FURTHER_ONLINE" />
	<define name="DISCORD_ALLOWED" if="desktop" />
	<define name="TRANSLATIONS_ALLOWED" />
	<define name="COPYSTATE_ALLOWED" if="MODS_ALLOWED mobile"/>
	<define name="IRIS_DEBUG"/>
	
	<define name="MULTITHREADED_LOADING" if="cpp" /> <!-- UNCOMMENTING THIS LINE WILL ENABLE MULTITHREADED LOADING, WHICH IMPROVES LOADING TIMES, BUT WITH A LOW CHANCE FOR THE GAME FREEZE ON SONG LOAD -->
	<define name="SHOW_LOADING_SCREEN" />
	<define name="STRICT_LOADING_SCREEN" /> <!-- Loading Screen for bad devices -->
	<define name="PSYCH_WATERMARKS"/> <!-- DELETE THIS TO REMOVE THE PSYCH LOGO FROM LOADING SCREEN -->
	
	<define name="TITLE_SCREEN_EASTER_EGG"/>
	<define name="BASE_GAME_FILES" />
	<define name="VIDEOS_ALLOWED" if="desktop || mobile" unless="32bits"/> <!-- IF YOU WANT TO USE VIDEOS ON YOUR SOURCE MOD, GET THIS LINE OUTSIDE OF THE SECTION -->

	<!-- ____________________________ Window Settings ___________________________ -->

	<!--These window settings apply to all targets-->
	<window width="1280" height="720" fps="60" background="#000000" hardware="true" vsync="false" allow-high-dpi="true" />

	<!--HTML5-specific-->
	<window if="html5" resizable="true" />

	<!--Desktop-specific-->
	<window if="desktop" orientation="landscape" fullscreen="false" resizable="true" vsync="false"/>

	<!--Mobile-specific-->
	<window if="mobile" orientation="landscape" fullscreen="true" resizable="false" allow-shaders="true" require-shaders="true" />

	<!--Switch-specific-->
	<window if="switch" orientation="landscape" fullscreen="true" width="0" height="0" resizable="true" />

	<!-- _____________________________ Path Settings ____________________________ -->

	<set name="BUILD_DIR" value="export/debug" if="debug" />
	<set name="BUILD_DIR" value="export/release" unless="debug" />
	<set name="BUILD_DIR" value="export/32bit" if="32bits" />

	<classpath name="source" />

	<!-- __________________________ Game Assets & Etc. __________________________ -->

	<!-- Assets -->
	<assets path="assets/fonts" />
	<assets path="assets/shared"        exclude="*.ogg" if="web"/>
	<assets path="assets/shared"        exclude="*.mp3" unless="web"/>
	<assets path="assets/embed"         exclude="*.ogg" if="web" embed="true"/>
	<assets path="assets/embed"         exclude="*.mp3" unless="web" embed="true"/>
	<assets path="assets/videos"        if="VIDEOS_ALLOWED"/>
	<assets path="assets/songs"         exclude="*.ogg" if="web"/>
	<assets path="assets/songs"         exclude="*.mp3" unless="web"/>
	<assets path="assets/week_assets"   rename="assets" exclude="*.ogg" if="web"/>
	<assets path="assets/week_assets"   rename="assets" exclude="*.mp3" unless="web"/>
	<section if="TITLE_SCREEN_EASTER_EGG">
		<assets path="assets/secrets" rename="assets/shared" exclude="*.ogg" if="web"/>
		<assets path="assets/secrets" rename="assets/shared" exclude="*.mp3"  unless="web"/>
	</section>

	<section if="TRANSLATIONS_ALLOWED">
		<assets path="assets/translations" rename="assets" exclude="*.ogg" if="web"/>
		<assets path="assets/translations" rename="assets" exclude="*.mp3"  unless="web"/>
	</section>

	<section if="BASE_GAME_FILES">
		<assets path="assets/base_game" rename="assets" exclude="*.ogg" if="web"/>
		<assets path="assets/base_game" rename="assets" exclude="*.mp3"  unless="web"/>
		<haxelib name="grig.audio" if="BASE_GAME_FILES"/>
		<haxelib name="funkin.vis" if="BASE_GAME_FILES"/>
	</section>

	<define name="CHECK_FOR_UPDATES"/>

	<section if="MODS_ALLOWED">
		<assets path='example_mods' rename='mods' embed='false' />
		<assets path='list.txt' rename='modsList.txt' />
	</section>
	
	<assets path='art/readme.txt' rename='do NOT readme.txt' unless="mobile" />

	<!-- Mobile Assets -->
	<section if="TOUCH_CONTROLS_ALLOWED">
		<assets path="mobile/assets"            rename="assets/mobile"/>
		<assets path="mobile/DPadModes"         rename="assets/mobile/DPadModes"/>
		<assets path="mobile/ActionModes"       rename="assets/mobile/ActionModes"/>
		<assets path="mobile/assets/MobilePad/ActionModes" rename="assets/shared/mobile/MobilePad/ActionModes"/>
		<assets path="mobile/assets/MobilePad/DPadModes" rename="assets/shared/mobile/MobilePad/DPadModes"/>
		<assets path="mobile/ActionModes"       rename="assets/shared/mobile/ActionModes"/>
		<assets path="mobile/DPadModes"         rename="assets/shared/mobile/DPadModes"/>
		<assets path="mobile/images"            rename="assets/mobile/images"/>
		<assets path="mobile/storageModes.txt"  rename="mobile/storageModes.txt"/>
	</section>

	<!-- OpenAL config -->
	<section if="desktop">
		<assets path="alsoft.txt" rename="plugins/alsoft.ini" type="text" if="windows"/>
		<assets path="alsoft.txt" rename="plugins/alsoft.conf" type="text" unless="windows"/>
	</section>

	<!-- _______________________________ Libraries ______________________________ -->

	<haxelib name="flixel"/>
	<haxelib name="flixel-addons" version="3.3.2"/>
	<!-- Further Online -->
	<haxelib name="colyseus" version="0.15.4" if="FURTHER_ONLINE"/>
	<haxelib name="colyseus-websocket" version="1.0.12" if="FURTHER_ONLINE"/>
	<haxelib name="tjson" version="1.4.0"/>
	
	<haxelib name="HtmlParser" />
	
	<!-- Legacy SScript -->
	<haxelib name="SScript" if="LEGACY_SSCRIPT"/>

	<!--Psych stuff needed-->
	<haxelib name="linc_luajit" if="LUA_ALLOWED"/>
	<haxelib name="hscript-iris" if="HSCRIPT_ALLOWED"/>
	<!-- Polymod VENDORED: source/polymod (v2.0.0, hscript motoru gomulu).
	     lib.haxe.org'da 2.0.0 yayinlanmadi (1.8.0'da motor YOK), bu yuzden
	     repo icine gomuldu. haxelib polymod kurulumu GEREKMEZ. -->
	<haxelib name="thx.semver"/>
	<haxelib name="jsonpatch"/>
	<haxelib name="hxvlc" if="VIDEOS_ALLOWED"/>
	<haxelib name="hxdiscord_rpc" if="DISCORD_ALLOWED"/>
	<haxelib name="flxanimate"/>

	<!-- Disable Discord IO Thread -->
	<haxedef name="DISCORD_DISABLE_IO_THREAD" if="hxdiscord_rpc" />
	<haxedef name="NO_PRECOMPILED_HEADERS" if="windows || linux" />

	<!-- Enables a terminal log prompt on debug builds -->
	<haxelib name="hxcpp-debug-server" if="debug"/>
	<haxedef name="HXC_LIBVLC_LOGGING" if="VIDEOS_ALLOWED debug" />
	<haxedef name="HXVLC_NO_SHARE_DIRECTORY" if="VIDEOS_ALLOWED" />
	<haxedef name="HXVLC_EXPERIMENTAL_WINDOWSARM" if="windows HXCPP_ARM64" />
	<define name="x86_BUILD" if="32bits" />
	
	<!-- ______________________________ Haxedefines _____________________________ -->

	<!--Enable the Flixel core recording system-->
	<!--<haxedef name="FLX_RECORD" />-->

	<!--Disable the right and middle mouse buttons-->
	<!-- <haxedef name="FLX_NO_MOUSE_ADVANCED" /> -->

	<!--Disable the native cursor API on Flash-->
	<!--<haxedef name="FLX_NO_NATIVE_CURSOR" />-->

	<!--Optimise inputs, be careful you will get null errors if you don't use conditionals in your game-->
	<!-- <haxedef name="FLX_NO_MOUSE" if="mobile" /> -->
	<!-- <haxedef name="FLX_NO_KEYBOARD" if="mobile" /> -->
	<!-- <haxedef name="FLX_NO_TOUCH" if="desktop" /> -->
	<!--<haxedef name="FLX_NO_GAMEPAD" />-->

	<!--Disable the Flixel core sound tray-->
	<!--<haxedef name="FLX_NO_SOUND_TRAY" />-->

	<!--Disable the Flixel sound management code-->
	<!--<haxedef name="FLX_NO_SOUND_SYSTEM" />-->

	<!--Disable the Flixel core focus lost screen-->
	<haxedef name="FLX_NO_FOCUS_LOST_SCREEN" />
	
	<!-- Show debug traces for hxCodec -->
	<haxedef name="HXC_DEBUG_TRACE" if="debug" />
	
	<!--Disable the Flixel core debugger. Automatically gets set whenever you compile in release mode!-->
	<haxedef name="FLX_NO_DEBUG" unless="debug" />
	<haxedef name="analyzer-optimize" unless="debug" />
	<!-- lime build windows -D ENABLE_TRACY -->
	<haxedef name="HXCPP_TELEMETRY" if="ENABLE_TRACY" />
	<haxedef name="HXCPP_TRACY" if="ENABLE_TRACY" />
	<haxedef name="HXCPP_TRACY_MEMORY" if="ENABLE_TRACY" />
	<haxedef name="HXCPP_TRACY_ON_DEMAND" if="ENABLE_TRACY" />

	<!--Enable this for Nape release builds for a serious peformance improvement-->
	<haxedef name="NAPE_RELEASE_BUILD" unless="debug" />
	
	<!--Used for crash handler-->
	<section if="cpp">
		<haxedef name="HXCPP_CHECK_POINTER" />
		<haxedef name="HXCPP_STACK_LINE" />
		<haxedef name="HXCPP_STACK_TRACE" />
		<haxedef name="HXCPP_CATCH_SEGV" unless="android" />
	</section>
	
	<!--Disable deprecated warnings-->
	<haxedef name='no-deprecation-warnings' />

	<!-- Haxe 4.3.0+: Enable pretty syntax errors and stuff. -->
	<!-- pretty (haxeflixel default), indent, classic (haxe compiler default) -->
	<haxedef name="message.reporting" value="pretty" />

	<!-- <certificate path="key.keystore" password="psychengine" alias="psychport" alias-password="psychengine" if="android" unless="debug" /> -->

	<!-- Category Type for Apple Systems -->
	<config:ios category_type="public.app-category.music-games" />
	<config:mac category_type="public.app-category.music-games" />

	<!-- Allow Access to Engine Files -->
	<haxedef name="SHARE_MOBILE_FILES" if="ios || android" />

	<!-- DocumentsProvider -->
	<section if="android">
			<template path="templates" />
			<java path="source/android/java" />
			<config:android extension="furtherengine.util.ShareImportUtil" />
			<config:android permission="android.permission.INTERNET" />
		<config:android permission="android.permission.ACCESS_NETWORK_STATE" />
		<!-- Allow http:// and ws:// to LAN server (Colyseus matchmake) -->
		<config:android>
			<application android:usesCleartextTraffic="true" />
		</config:android>
		<config:android permission="android.permission.MANAGE_DOCUMENTS" />
		<config:android permission="android.permission.MANAGE_EXTERNAL_STORAGE" />
		<config:android permission="android.permission.READ_EXTERNAL_STORAGE" />
		<config:android permission="android.permission.WRITE_EXTERNAL_STORAGE" />
		<config:android accept-file-intent="application/zip" />
		<config:android accept-file-intent="application/x-zip-compressed" />
	</section>
	
	<define name="TOUCH_CONTROLS_ALLOWED" if="android" />
	<define name="TOUCH_CONTROLS_ALLOWED" if="ios" />

	<!--Macro fixes-->
	<haxeflag name="--macro" value="allowPackage('flash')" />
	<haxeflag name="--macro" value="include('my.pack')" />
	<haxeflag name="--macro" value="include('cne.compatibility')" />
	<haxeflag name="--macro" value="include('vslice.compatibility', false)" />

	<haxedef name="hscriptPos" if="HSCRIPT_ALLOWED" />

	<!-- _________________________________ Custom _______________________________ -->

	<assets path='art/icons/iconOG.png' rename='icon.png' if="linux || mac" />
	
	<icon path="art/icons/icon16.png" size='16'/>
	<icon path="art/icons/icon32.png" size='32'/>
	<icon path="art/icons/icon64.png" size='64'/>
	<icon path="art/icons/iconOG.png" />
</project>